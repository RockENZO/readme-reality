{
  "name": "@rockenzo/readme-reality",
  "version": "0.1.1",
  "description": "Catch broken quickstarts before your users do. Offline README checks with line-level repository evidence.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "readme-reality": "dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/types/core.d.ts",
      "import": "./dist/core.mjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RockENZO/readme-reality.git"
  },
  "homepage": "https://rockenzo.github.io/readme-reality/",
  "keywords": [
    "readme",
    "quickstart",
    "documentation",
    "developer-tools",
    "github-actions"
  ],
  "scripts": {
    "build": "node scripts.mjs && tsc --emitDeclarationOnly",
    "build:web": "vite build",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "test": "node --import tsx --test test/*.test.ts",
    "verify": "npm run typecheck && npm test && npm run build && npm run build:web"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  }
}
